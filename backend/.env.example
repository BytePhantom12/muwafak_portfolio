# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Configuration
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/portfolio
MONGODB_DB_NAME=portfolio

# JWT Secret (use a strong random string in production)
JWT_SECRET=your_jwt_secret_key_here_change_this_in_production

# Admin Session Duration in milliseconds (default: 86400000 = 24 hours)
ADMIN_SESSION_DURATION=86400000

# Optional: required to create additional users after the first bootstrap user
REGISTRATION_SECRET=replace_with_a_strong_random_value

# Optional comma-separated frontend preview/deployment origins
ALLOWED_ORIGINS=https://example.vercel.app

# Cloudinary Configuration
# Get your credentials from: https://console.cloudinary.com/
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
